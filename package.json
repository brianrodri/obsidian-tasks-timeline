{
    "name": "obsidian-tasks-timeline",
    "version": "1.0.0",
    "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
    "main": "dist/main.js",
    "scripts": {
        "test": "vitest run",
        "watch": "vitest --watch",
        "coverage": "vitest run --coverage",
        "watch-coverage": "vitest --watch --coverage",
        "hotreload": "vite build --mode development --outDir ./test-vault/.obsidian/plugins/obsidian-tasks-timeline/ --watch",
        "build": "tsc && vite build",
        "docs": "typedoc src/main.tsx --plugin typedoc-plugin-coverage --out docs/ --excludeExternals --excludePrivate --excludeProtected",
        "lint": "eslint .",
        "prepare": "node .husky/install.js",
        "commitlint": "commitlint --edit",
        "clean": "rm -rf node_modules/ dist/ coverage/ docs/"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "@preact/signals": "^2.9.3",
        "core-js": "^3.49.0",
        "lodash": "^4.18.1",
        "lucide-preact": "^1.24.0",
        "luxon": "^3.7.2",
        "path-browserify": "^1.0.1",
        "preact": "^10.29.7",
        "react": "npm:@preact/compat",
        "react-dom": "npm:@preact/compat",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@preact/preset-vite": "^2.10.5",
        "@semantic-release/git": "^10.0.1",
        "@testing-library/preact": "^3.2.4",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/core-js": "^2.5.8",
        "@types/lodash": "^4.17.24",
        "@types/luxon": "^3.7.2",
        "@typescript-eslint/eslint-plugin": "^8.63.0",
        "@typescript-eslint/parser": "^8.63.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.39.4",
        "eslint-config-preact": "^2.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-boundaries": "^7.0.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "obsidian": "^1.13.1",
        "obsidian-dataview": "^0.5.68",
        "semantic-release": "^25.0.5",
        "semantic-release-obsidian-plugin": "^1.2.1",
        "tslib": "^2.8.1",
        "typedoc": "^0.28.20",
        "typedoc-plugin-coverage": "^4.0.3",
        "typescript": "^6.0.3",
        "utility-types": "^3.11.0",
        "vite": "^8.1.4",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "obsidian-calendar-ui": "brianrodri/obsidian-calendar-ui"
    },
    "allowScripts": {
        "core-js@3.49.0": true,
        "fsevents@2.3.3": true,
        "github:lishid/cm-language#b817e72a9861b3f8a50a92a2ea53cbafc4f88eb3": true
    }
}
