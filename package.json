{
    "name": "obsidian-tasks-timeline",
    "version": "1.0.0",
    "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
    "main": "dist/main.js",
    "scripts": {
        "test": "vitest run",
        "watch": "vitest --watch",
        "coverage": "vitest run --coverage",
        "watch-coverage": "vitest --watch --coverage",
        "hotreload": "vite build --mode development --outDir ./test-vault/.obsidian/plugins/obsidian-tasks-timeline/ --watch",
        "build": "tsc -b && vite build",
        "docs": "typedoc src/main.tsx --tsconfig tsconfig.app.json --plugin typedoc-plugin-coverage --out docs/ --excludeExternals --excludePrivate --excludeProtected",
        "lint": "eslint .",
        "format": "prettier --write src *.config.*",
        "format:check": "prettier --check src *.config.*",
        "prepare": "node .husky/install.js",
        "commitlint": "commitlint --edit",
        "clean": "rm -rf node_modules/ dist/ coverage/ docs/"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "dependencies": {
        "@preact/signals": "^2.11.3",
        "lodash": "^4.18.1",
        "lucide-preact": "^1.61.0",
        "luxon": "^3.7.2",
        "preact": "^11.0.2",
        "react": "npm:@preact/compat",
        "react-dom": "npm:@preact/compat",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@preact/preset-vite": "^2.10.6",
        "@semantic-release/git": "^11.0.1",
        "@testing-library/preact": "^3.2.6",
        "@testing-library/user-event": "^14.6.8",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/lodash": "^4.17.27",
        "@types/luxon": "^3.7.6",
        "@types/node": "^24.19.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "obsidian": "^1.14.4",
        "obsidian-dataview": "^0.5.68",
        "prettier": "^3.9.10",
        "semantic-release": "^25.0.9",
        "semantic-release-obsidian-plugin": "^1.2.1",
        "typedoc": "^0.28.20",
        "typedoc-plugin-coverage": "^4.0.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.0",
        "utility-types": "^3.11.0",
        "vite": "^8.3.5",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "obsidian-calendar-ui": "brianrodri/obsidian-calendar-ui"
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "github:lishid/cm-language#b817e72a9861b3f8a50a92a2ea53cbafc4f88eb3": true
    }
}
